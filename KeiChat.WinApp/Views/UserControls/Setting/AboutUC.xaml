<UserControl x:Class="KeiChat.WinApp.Views.UserControls.Setting.AboutUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KeiChat.WinApp.Views.UserControls.Setting"
             xmlns:ui="clr-namespace:KeiChat.WinUI.Controls;assembly=KeiChat.WinUI"
             mc:Ignorable="d" 
             d:DesignWidth="400"
             d:DesignHeight="500"
             d:Background="#F1F1F1">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Border Margin="32 0" 
                    CornerRadius="10"
                    Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" 
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="16 12 16 0"
                               FontSize="14"
                               Foreground="{DynamicResource ForegroundPrimary}"
                               Text="{StaticResource SettingAboutVersionString}"
                               d:Text="版本信息"/>
                    <ui:RadiusDefaultButton Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="0 0 16 0"
                                            Padding="10 0"
                                            Height="24"
                                            FontSize="12"
                                            CornerRadius="12"
                                            FontWeight="Normal"
                                            Content="检查更新"
                                            Click="CheckUpdateButton_Click"/>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="16 8 16 12"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundSecondary}"
                                   d:Text="6.0.9.0"
                                   x:Name="VersionTextBlock"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningSolidColorBrush}"
                                   Text="（演示版）"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource ForegroundSecondary}"
                   Text="自定义页面"/>

        <!--<Image Width="72"
               Height="72"
               Margin="0 0 0 42"
               VerticalAlignment="Bottom"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="pack://application:,,,/Resources/logo.png"/>-->

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="16"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource ForegroundLow}"
                   Text="Copyright (c) 2023 demo, All Rights Reserved."/>
    </Grid>
</UserControl>
